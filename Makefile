# **************************************************************************** #
#                                  VARIABLES                                   #
# **************************************************************************** #

NAME		= inception
COMPOSE		= docker compose -f srcs/docker-compose.yml

# **************************************************************************** #
#                                    RULES                                     #
# **************************************************************************** #

.SILENT:

all: up

up:
	$(COMPOSE) up --build -d

down:
	$(COMPOSE) down

# **************************************************************************** #
#                                   CLEANING                                   #
# **************************************************************************** #

clean:
	$(COMPOSE) down --remove-orphans

fclean:
	$(COMPOSE) down --volumes --remove-orphans

re: fclean up

.PHONY: all up down clean fclean re
